# ============================================================
# World Bingo API — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.
# ============================================================

# --- Server ---
NODE_ENV=development          # development | production
PORT=8080
HOST=0.0.0.0

# --- Database (PostgreSQL) ---
# DATABASE_URL is defined in the root .env — do not set it here.
# Root .env is the single source of truth: cp ../../.env.example ../../.env

# --- Cache & Queues (Redis) ---
REDIS_URL="redis://localhost:6379"

# --- Authentication (RS256) ---
# Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Then base64-encode (preserving newlines as \n) and store here:
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# --- File Storage ---
# For local dev use 'local'; for production use 'gcs'
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads           # Used when STORAGE_PROVIDER=local

# Google Cloud Storage (used when STORAGE_PROVIDER=gcs)
# NOTE: the code reads process.env.GCS_BUCKET (see lib/storage.ts and
# services/support/attachment-url.ts) — this must be GCS_BUCKET, not
# GCS_BUCKET_NAME. A GCS deployment set up with the wrong name here silently
# fails: uploads throw, and the support attachment allowlist derives no
# storage.googleapis.com host, so every attachment gets rejected with
# SUPPORT_BAD_ATTACHMENT.
GCS_BUCKET="world-bingo-receipts"
GCS_PROJECT_ID="your-gcp-project-id"
GCS_KEY_FILE="./gcs-key.json"  # Path to service account JSON key

# --- Payment Gateways (Tier 6 — not needed for MVP) ---
# CHAPA_SECRET_KEY="CHASECK_TEST-..."
# CHAPA_WEBHOOK_SECRET="..."
# TELEBIRR_APP_ID="..."
# TELEBIRR_APP_KEY="..."

# --- Third-Party Game Providers (GASea Seamless Wallet API v3.1.0) ---
# Request credentials from GASea Technical Support
GASEA_API_BASE_URL=""              # e.g. https://api.gasea.com/v3
GASEA_API_KEY=""                   # 64-char alphanumeric (sent as X-API-Key header)
GASEA_API_SECRET=""                # 64-char alphanumeric (used for HMAC-SHA256 X-Signature)
GASEA_DEFAULT_CURRENCY="ETB"
# Public URL of this API — used in lobbyUrl for game launch and as callback base.
# Also the origin ZareCash hosted checkout returns players to: it MUST share an
# origin with the Custom URL configured for this tenant in the ZareCash console,
# or every POST /v1/checkout/sessions fails with invalid_return_url.
WEB_BASE_URL="https://www.aradabingo.bet"

# --- Palace Casino (seamless wallet provider) ---
PALACE_API_BASE_URL=
PALACE_API_TOKEN=
PALACE_CALLBACK_TOKEN=
PALACE_CURRENCY=ETB

# ── Provider gateway hub ─────────────────────────────────────────────
# Multiple deployments can share ONE upstream provider account by routing
# all provider traffic through an elected "hub" deployment.
#   standalone (default) = single deployment, talks to providers directly (no change).
#   hub  = owns the provider token + the single callback URL; routes for spokes.
#   spoke = no provider credentials; forwards every provider call to the hub.
DEPLOYMENT_ROLE=standalone
# 3 lowercase-alphanumeric chars, unique per deployment. Required unless standalone.
DEPLOYMENT_CODE=
# Hub only: JSON array of the spokes this hub serves.
HUB_DEPLOYMENTS=                     # [{"code":"s01","baseUrl":"https://s01.example","secret":"<shared>"}]
# Spoke only: where the hub lives + the shared secret it authenticates with.
HUB_URL=
HUB_SHARED_SECRET=
# Optional: tighter timeout (ms) for the hub's forward leg to a spoke callback sink.
PALACE_SPOKE_TIMEOUT_MS=5000

# --- Telegram Login Widget ---
# Bot token from @BotFather — used only for hash verification, users never interact with the bot
TELEGRAM_BOT_TOKEN=

# --- Observability ---
# All integrations below are OFF by default: leave a value empty/false and the
# feature stays inert. The API boots and runs normally with nothing configured.
# Infra/exporter vars (GLITCHTIP_*, POSTGRES_EXPORTER_DSN, etc.) live in the root
# .env. See docs/observability.md for the full runbook.

# Error tracking (Sentry SDK → self-hosted GlitchTip).
# Empty DSN → reporting is a complete no-op.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=                       # optional: git sha / version tag

# Distributed tracing (OpenTelemetry auto-instrumentation → Tempo).
# OTEL_ENABLED=false → entrypoint runs node without --import (no instrumentation).
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://wb-tempo:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=world-bingo-api
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# Log shipping (pino → Loki). Empty LOKI_URL → logs stay on stdout only.
LOKI_URL=
LOKI_LABEL_APP=world-bingo-api

# ─── Deposit auto-verification (telebirr receipt) ─────────────────────────────
# Optional proxy for OUTBOUND telebirr receipt fetches only (does not affect
# other traffic). Use when this server can't reach transactioninfo.ethiotelecom.et
# directly (e.g. hosted outside Ethiopia). Supports http://, https://, socks5://.
# Empty = fetch directly. SECURITY: an untrusted proxy can MITM/forge a receipt
# (TLS to the receipt host is relaxed), so only use a free/untrusted proxy in
# shadow mode (deposit_auto_verify_max_amount=0). For real auto-crediting, use a
# trusted egress (own ET box / reputable paid proxy) or the official telebirr API.
DEPOSIT_VERIFY_PROXY=
# SPKI public-key pinning for the receipt host — this is what makes an UNTRUSTED
# proxy safe for real auto-crediting. With a pin set, the receipt host's TLS key is
# verified end-to-end even through the proxy, so a MITM/forged receipt fails closed
# (routed to manual review, never credited). Empty = unpinned (shadow/cap-0 only).
# Comma-separate multiple values to pre-stage the next key before cert rotation.
# Capture the genuine pin from a TRUSTED ET vantage (NOT through the free proxy):
#   node scripts/capture-receipt-spki.mjs transactioninfo.ethiotelecom.et 443
DEPOSIT_VERIFY_SPKI_PINS=
# Fetch tuning (optional): timeout ms, and BullMQ rate-limit floor.
# DEPOSIT_VERIFY_RATE_MAX=20
# DEPOSIT_VERIFY_RATE_WINDOW_MS=60000
# DEPOSIT_VERIFY_COOLDOWN_MS=30000

# ─── Player CRM ───────────────────────────────────────────────────────────────
# Phase 3 (bonus-grant campaigns) ships DARK. Segments, CSV export and in-app
# message campaigns work regardless. Do NOT set this to true until provider
# rollbacks stop crediting real balance for bonus-funded bets
# (palace-wallet.service.ts, third-party-wallet.service.ts) — until then a bonus
# campaign is effectively a cash campaign.
CRM_BONUS_GRANTS_ENABLED=false

# ─── Support chat ──────────────────────────────────────────────────────────
# Must stay false for Phase 1. There is no AI implemented behind it yet —
# setting it true only changes routing: new threads start in BOT status
# instead of OPEN, and the admin inbox's default "unassigned" filter only
# shows OPEN, so those BOT threads would appear only under the "all" tab
# (effectively invisible to the normal clerk workflow) until Phase 2 ships
# the bot that's supposed to answer them.
SUPPORT_AI_ENABLED=false

# Comma-separated escape hatch for the attachment host allowlist (support
# chat image/receipt uploads). Empty by default, which is correct for
# STORAGE_PROVIDER=local — only relative /uploads/ paths are accepted then.
# MinIO and GCS hosts are derived automatically from MINIO_ENDPOINT and
# GCS_BUCKET, so you only need this when something else fronts the storage
# bucket, e.g. a CDN in front of MinIO/GCS with its own hostname.
SUPPORT_ATTACHMENT_HOSTS=

# ─── ZareCash (deposits & withdrawals as a service) ──────────────────────────
# No-op when ZARECASH_ENABLED=false. Methods opt in individually via
# PaymentMethod.gateway = 'zarecash'.
ZARECASH_ENABLED=false
ZARECASH_BASE_URL=https://api.zarecash.com
ZARECASH_API_KEY=
ZARECASH_WEBHOOK_SECRET=
ZARECASH_MODE=test
ZARECASH_TIMEOUT_MS=10000
# Retry budget for a ZareCash payout submission before the worker gives up and
# refunds the player. Must be a positive integer; anything else falls back to 8.
# Each attempt is bounded by ZARECASH_TIMEOUT_MS, so 8 attempts with exponential
# backoff is roughly a couple of minutes of trying before the terminal refund.
ZARECASH_WITHDRAWAL_ATTEMPTS=8
# Hosted checkout has no env switch of its own. It is enabled by the seeded
# PaymentMethod row (code `zarecash`) having hostedCheckout = true AND
# enabled = true, so the kill switch is one toggle in the admin panel.
