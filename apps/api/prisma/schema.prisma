generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(uuid())
  serial                Int                    @unique @default(autoincrement())
  username              String?                @unique
  phone                 String?                @unique
  passwordHash          String?
  telegramId            String?                @unique
  telegramUsername      String?
  firstName             String?
  lastName              String?
  photoUrl              String?
  role                  UserRole               @default(PLAYER)
  isActive              Boolean                @default(true)
  avatarUrl             String?
  referralCode          String?                @unique
  referredById          String?
  botTotalSpent         Decimal                @default(0) @db.Decimal(12, 2)
  wallet                Wallet?
  transactions          Transaction[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  entries               GameEntry[]
  refreshTokens         RefreshToken[]
  notifications         Notification[]
  referredBy            User?                  @relation("Referrals", fields: [referredById], references: [id])
  referrals             User[]                 @relation("Referrals")
  referralRewards       ReferralReward[]
  tournamentEntries     TournamentEntry[]
  cashbackDisbursements CashbackDisbursement[]
  playerMetrics         PlayerMetrics?
  campaignDeliveries    CampaignDelivery[]
  predictionOrders      PredictionOrder[]
  predictionPositions   PredictionPosition[]
  bonusGrants           BonusGrant[]
  bonusRuleMemberships  BonusRuleMember[]
  supportConversations  SupportConversation[]  @relation("SupportConversations")
  supportAssignments    SupportConversation[]  @relation("SupportAssignments")

  @@index([role])
  @@index([referralCode])
  @@map("users")
}

// realBalance and bonusBalance also carry raw CHECK (>= 0) constraints at the
// database level (see migration 20260821000001_add_wallet_balance_check_constraints).
// Prisma's schema DSL doesn't model CHECK constraints for this Prisma version, so
// they exist only in the migration SQL, not as an attribute here. This is a
// backstop against any spend path — present or future — that fails to prevent a
// double-spend in application code: instead of a silent negative balance, the
// offending transaction fails loudly at commit time.
model Wallet {
  id           String       @id @default(uuid())
  userId       String       @unique
  realBalance  Decimal      @default(0) @db.Decimal(20, 8)
  bonusBalance Decimal      @default(0) @db.Decimal(20, 8)
  spendAccount SpendAccount @default(REAL)
  currency     String       @default("ETB")
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Game {
  id           String        @id @default(uuid())
  title        String
  status       GameStatus    @default(WAITING)
  ticketPrice  Decimal       @db.Decimal(10, 2)
  maxPlayers   Int
  minPlayers   Int           @default(2)
  houseEdgePct Decimal       @default(10) @db.Decimal(5, 2)
  pattern      PatternType
  calledBalls  Int[]
  entries      GameEntry[]
  createdAt    DateTime      @default(now())
  startedAt    DateTime?
  endedAt      DateTime?
  winnerId     String?
  templateId   String?
  template     GameTemplate? @relation(fields: [templateId], references: [id])

  @@index([status])
  @@index([status, createdAt])
  @@index([templateId, status])
  @@map("games")
}

// ─── Preconfigured Game Templates ──────────────────────────────────────────────
// Always-on game templates. The scheduler ensures at least one WAITING game
// exists per active template at all times. When minPlayers join, a 60-second
// countdown auto-starts the game — no manual admin start needed.
model GameTemplate {
  id            String      @id @default(uuid())
  title         String // e.g. "Quick 10 ETB"
  ticketPrice   Decimal     @db.Decimal(10, 2)
  maxPlayers    Int
  minPlayers    Int         @default(2)
  houseEdgePct  Decimal     @default(10) @db.Decimal(5, 2)
  pattern       PatternType
  active        Boolean     @default(true) // toggle template on/off
  countdownSecs Int         @default(60) // seconds to wait after minPlayers join
  botEnabled    Boolean     @default(false) // master on/off for bots on this template
  botCount      Int         @default(0) // max number of bot players to inject per game
  botFillToMin  Boolean     @default(true) // if true, bots fill to minPlayers (botCount is the ceiling)
  botMaxSpend   Decimal?    @db.Decimal(10, 2) // per-template override for max ETB a single bot can spend
  botWinRate    Int         @default(100) // % chance a bot claims bingo when its cartela wins (0–100)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  games         Game[]

  @@map("game_templates")
}

model Cartela {
  id      String      @id @default(uuid())
  serial  String      @unique
  grid    Json
  entries GameEntry[]

  @@map("cartelas")
}

model GameEntry {
  id        String   @id @default(uuid())
  gameId    String
  userId    String
  cartelaId String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  cartela   Cartela  @relation(fields: [cartelaId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([gameId, cartelaId])
  @@index([userId])
  @@index([gameId])
  @@index([gameId, userId])
  @@map("game_entries")
}

model Transaction {
  id                   String               @id @default(uuid())
  userId               String
  type                 TransactionType
  amount               Decimal              @db.Decimal(12, 2)
  originalAmount       Decimal?             @db.Decimal(12, 2)
  status               PaymentStatus        @default(PENDING)
  referenceId          String?
  receiptUrl           String?
  note                 String?
  balanceBefore        Decimal?             @db.Decimal(12, 2)
  balanceAfter         Decimal?             @db.Decimal(12, 2)
  bonusBalanceBefore   Decimal?             @db.Decimal(12, 2)
  bonusBalanceAfter    Decimal?             @db.Decimal(12, 2)
  bonusExpiresAtSpend  DateTime?
  paymentTransactionId String?              @unique
  gatewayRef           String?              @unique
  senderName           String?
  senderAccount        String?
  reviewedById         String? // admin/clerk who approved or rejected (audit + separation-of-duties)
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  depositVerification  DepositVerification?
  createdAt            DateTime             @default(now())

  @@index([userId])
  @@index([type, status])
  @@index([userId, type])
  @@index([createdAt])
  @@index([reviewedById])
  @@map("transactions")
}

enum UserRole {
  PLAYER
  CLERK
  ADMIN
  SUPER_ADMIN
}

enum GameStatus {
  WAITING
  STARTING
  LOCKING
  IN_PROGRESS
  PAYOUT
  REFUNDING
  COMPLETED
  CANCELLED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  GAME_ENTRY
  PRIZE_WIN
  REFUND
  FIRST_DEPOSIT_BONUS
  CASHBACK_BONUS
  ADMIN_REAL_ADJUSTMENT
  ADMIN_BONUS_ADJUSTMENT
  TP_BET
  TP_WIN
  TP_ROLLBACK
  TP_ADJUSTMENT
  CAMPAIGN_BONUS
  PREDICTION_ORDER_HOLD
  PREDICTION_ORDER_RELEASE
  PREDICTION_WIN
  PREDICTION_REFUND
  DAILY_DEPOSIT_BONUS
  WEEKLY_DEPOSIT_BONUS
  BONUS_EXPIRED
}

enum PaymentStatus {
  PENDING
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum PatternType {
  ANY_LINE
  DIAGONAL
  FULL_CARD
  X_PATTERN
  CORNERS
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

enum NotificationType {
  GAME_CANCELLED
  REFUND_PROCESSED
  DEPOSIT_APPROVED
  DEPOSIT_REJECTED
  WITHDRAWAL_PROCESSED
  GAME_WON
  GAME_STARTING
  REFERRAL_BONUS
  TOURNAMENT_STARTING
  TOURNAMENT_WON
  TOURNAMENT_ELIMINATED
  CASHBACK_AWARDED
  CAMPAIGN_MESSAGE
  PREDICTION_SETTLED
  PREDICTION_VOIDED
  SUPPORT_REPLY
}

model ReferralReward {
  id         String    @id @default(uuid())
  referrerId String
  refereeId  String    @unique // one reward per referred user
  amount     Decimal   @db.Decimal(12, 2)
  paid       Boolean   @default(false)
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
  referrer   User      @relation(fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@map("referral_rewards")
}

// ─── Progressive Jackpot (T59) ────────────────────────────────────────────────
model Jackpot {
  id        String       @id @default(uuid())
  amount    Decimal      @default(0) @db.Decimal(14, 2)
  lastWonAt DateTime?
  lastWonBy String? // userId of last winner
  updatedAt DateTime     @updatedAt
  wins      JackpotWin[]

  @@map("jackpot")
}

model JackpotWin {
  id        String   @id @default(uuid())
  jackpotId String
  userId    String
  gameId    String
  amount    Decimal  @db.Decimal(14, 2)
  ballCount Int // number of balls called when won
  createdAt DateTime @default(now())
  jackpot   Jackpot  @relation(fields: [jackpotId], references: [id])

  @@index([userId])
  @@map("jackpot_wins")
}

// ─── Tournament Mode (T60) ─────────────────────────────────────────────────────
enum TournamentStatus {
  REGISTRATION // open for sign-ups
  IN_PROGRESS // rounds are running
  COMPLETED // final winner determined
  CANCELLED
}

enum CashbackRefundType {
  PERCENTAGE
  FIXED
}

enum CashbackFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum BonusRuleType {
  DAILY_DEPOSIT
  WEEKLY_DEPOSIT
}

enum BonusRewardType {
  FIXED
  PERCENTAGE
}

enum BonusGrantStatus {
  ACTIVE
  CONSUMED
  EXPIRED
}

enum SpendAccount {
  REAL
  BONUS
}

model Tournament {
  id              String            @id @default(uuid())
  title           String
  status          TournamentStatus  @default(REGISTRATION)
  entryFee        Decimal           @db.Decimal(10, 2)
  maxPlayers      Int               @default(32)
  currentPlayers  Int               @default(0)
  prizePool       Decimal           @default(0) @db.Decimal(14, 2)
  houseEdgePct    Decimal           @default(10) @db.Decimal(5, 2)
  winnerId        String?
  rounds          Int               @default(1) // total rounds played
  scheduledAt     DateTime?
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime          @default(now())
  entries         TournamentEntry[]
  tournamentGames TournamentGame[]

  @@index([status])
  @@index([status, scheduledAt])
  @@map("tournaments")
}

model TournamentEntry {
  id           String     @id @default(uuid())
  tournamentId String
  userId       String
  round        Int        @default(1) // last round they participated in
  eliminated   Boolean    @default(false)
  eliminatedAt DateTime?
  score        Int        @default(0) // # of games won in this tournament
  joinedAt     DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@index([tournamentId, eliminated])
  @@map("tournament_entries")
}

model TournamentGame {
  id           String     @id @default(uuid())
  tournamentId String
  gameId       String     @unique // each game belongs to at most one tournament
  round        Int
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId, round])
  @@map("tournament_games")
}

// ─── Cashback Promotions ──────────────────────────────────────────────────────
model CashbackPromotion {
  id            String                 @id @default(uuid())
  name          String
  lossThreshold Decimal                @db.Decimal(12, 2) // net real-balance loss required to qualify
  refundType    CashbackRefundType // PERCENTAGE or FIXED
  refundValue   Decimal                @db.Decimal(10, 2) // e.g. 10.00 = 10% OR 50.00 = 50 ETB flat
  frequency     CashbackFrequency // evaluation window: DAILY | WEEKLY | MONTHLY
  startsAt      DateTime
  endsAt        DateTime
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
  disbursements CashbackDisbursement[]

  @@map("cashback_promotions")
}

model CashbackDisbursement {
  id          String            @id @default(uuid())
  promotionId String
  userId      String
  amount      Decimal           @db.Decimal(12, 2)
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime          @default(now())
  promotion   CashbackPromotion @relation(fields: [promotionId], references: [id])
  user        User              @relation(fields: [userId], references: [id])

  @@unique([promotionId, userId, periodStart])
  @@index([promotionId, periodStart])
  @@map("cashback_disbursements")
}

model BonusRule {
  id              String            @id @default(uuid())
  name            String
  type            BonusRuleType
  threshold       Decimal           @db.Decimal(12, 2)
  rewardType      BonusRewardType
  rewardValue     Decimal           @db.Decimal(12, 2)
  maxReward       Decimal?          @db.Decimal(12, 2)
  validityHours   Int
  startsAt        DateTime
  endsAt          DateTime
  isActive        Boolean           @default(true)
  isSegmentScoped Boolean           @default(false)
  segmentId       String?
  segment         Segment?          @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  segmentName     String?
  memberCount     Int?
  members         BonusRuleMember[]
  createdAt       DateTime          @default(now())
  grants          BonusGrant[]

  @@index([isActive, type])
  @@map("bonus_rules")
}

model BonusGrant {
  id          String           @id @default(uuid())
  userId      String
  ruleId      String?
  amount      Decimal          @db.Decimal(12, 2)
  remaining   Decimal          @db.Decimal(12, 2)
  periodStart DateTime
  expiresAt   DateTime?
  status      BonusGrantStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  rule        BonusRule?       @relation(fields: [ruleId], references: [id])
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ruleId, userId, periodStart])
  @@index([userId, status, expiresAt])
  @@index([status, expiresAt])
  @@map("bonus_grants")
}

/// A bonus rule's frozen target cohort. Materialized once when the rule is
/// created and never recomputed — see the design spec §3. The composite
/// primary key is also the index the hot path uses: grant-time asks only
/// "is this user in this rule", which [ruleId, userId] answers directly.
model BonusRuleMember {
  ruleId String
  userId String
  rule   BonusRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ruleId, userId])
  @@map("bonus_rule_members")
}

// ─── Site Settings / Feature Flags ──────────────────────────────────────────────
// A simple key-value store for admin-togglable features.
// Seeded with defaults; the admin panel can flip them on/off.
model SiteSetting {
  key       String   @id // e.g. "feature_referrals", "feature_tournaments"
  value     String // "true" / "false" or any string value
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// Singleton white-label brand config. Absent row => app uses DEFAULT_BRAND.
model BrandSetting {
  id          String   @id @default("default")
  displayName String
  shortName   String
  logoUrl     String?
  faviconUrl  String?
  themeId     String   @default("arada")
  tokens      Json
  updatedAt   DateTime @updatedAt

  @@map("brand_settings")
}

// ─── Payment Methods ─────────────────────────────────────────────────────────
// Configurable deposit/withdrawal payment methods managed via the admin panel.

enum PaymentMethodType {
  DEPOSIT
  WITHDRAWAL
}

model PaymentMethod {
  id                String            @id @default(uuid())
  code              String            @unique // e.g. "telebirr", "cbe", "awash"
  name              String // display name, e.g. "TeleBirr"
  type              PaymentMethodType
  merchantAccount   String? // account/phone number for deposit methods
  merchantName      String? // recipient name shown before account number (e.g. "John Doe")
  instructions      String? // shown to users during deposit flow
  icon              String? // emoji or icon identifier, e.g. "📱"
  enabled           Boolean           @default(true)
  autoVerify        Boolean           @default(false) // opt this method into deposit auto-verification
  gateway           String            @default("manual") // "manual" | "zarecash"
  gatewayMethodCode String? // ZareCash methodCode when gateway = "zarecash"
  sortOrder         Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("payment_methods")
}

// ─── House Wallet & Transactions ─────────────────────────────────────────────
// Singleton house wallet tracking all platform income/expenses.
model HouseWallet {
  id        String   @id @default("house")
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt

  @@map("house_wallet")
}

model HouseTransaction {
  id            String               @id @default(uuid())
  type          HouseTransactionType
  amount        Decimal              @db.Decimal(12, 2)
  description   String
  gameId        String?
  userId        String?
  balanceBefore Decimal              @db.Decimal(12, 2)
  balanceAfter  Decimal              @db.Decimal(12, 2)
  createdAt     DateTime             @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([userId])
  @@map("house_transactions")
}

enum HouseTransactionType {
  COMMISSION
  BOT_PRIZE_WIN
  REFUND_ISSUED
  PREDICTION_FEE
}

// ─── Third-Party Game Providers ───────────────────────────────────────────────

enum GameProviderStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum ThirdPartyTxType {
  BET
  BET_RESULT
  BET_DEBIT
  BET_CREDIT
  ROLLBACK
  ADJUSTMENT
}

enum ThirdPartyTxStatus {
  COMPLETED
  ROLLED_BACK
  FAILED
}

// One row per aggregator (GASea is the first; more can be added).
// Credentials (apiKey, apiSecret) are stored in env vars only — not in this table.
model GameProvider {
  id           String                @id @default(uuid())
  code         String                @unique // e.g. "gasea"
  name         String // e.g. "GASea"
  status       GameProviderStatus    @default(ACTIVE)
  apiBaseUrl   String // e.g. "https://api.gasea.com/v3"
  currency     String                @default("ETB")
  isPrimary    Boolean               @default(false)
  config       Json? // provider-specific config blob
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  vendors      GameVendor[]
  games        ProviderGame[]
  userAccounts ProviderUserAccount[]

  @@map("game_providers")
}

// Game studios / sub-brands within a provider (e.g. Pragmatic Play, PG Soft).
model GameVendor {
  id           String         @id @default(uuid())
  providerId   String
  code         String // e.g. "PP"
  name         String // e.g. "Pragmatic Play"
  categoryCode String? // e.g. "SLOTS,LIVE"
  isActive     Boolean        @default(true)
  lastSyncedAt DateTime?
  provider     GameProvider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  games        ProviderGame[]

  @@unique([providerId, code])
  @@index([providerId, isActive])
  @@map("game_vendors")
}

// Individual games from a provider.
model ProviderGame {
  id             String       @id @default(uuid())
  providerId     String
  vendorId       String
  gameCode       String // e.g. "PP_1302" — unique within provider
  gameName       String
  categoryCode   String // e.g. "SLOTS", "LIVE", "TABLE"
  imageSquare    String?
  imageLandscape String?
  languageCodes  String[] // e.g. ["en", "am"]
  platformCodes  String[] // e.g. ["H5", "WEB"]
  currencyCodes  String[] // e.g. ["ETB", "USD"]
  isActive       Boolean      @default(true)
  autoHidden     Boolean      @default(false) // hidden by us after an upstream "disabled" launch; re-enabled on next sync
  sortOrder      Int          @default(0)
  featuredRank   Int? // curated lobby rank projected from FeaturedGame; null = unpinned
  provider       GameProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  vendor         GameVendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([providerId, gameCode])
  @@index([categoryCode])
  @@index([isActive, categoryCode])
  @@index([featuredRank])
  @@map("provider_games")
}

// ─── Curated lobby priority ──────────────────────────────────────────────────
// Admin-managed ordering for the player lobby. A pin matches provider games by
// normalized game name, so one list covers every provider carrying the same
// title and a newly synced provider inherits the order. The list is projected
// onto ProviderGame.featuredRank so ordering — and therefore pagination —
// happens in the database rather than in the browser.
model FeaturedGame {
  id        String   @id @default(uuid())
  nameKey   String   @unique // lower(gameName), non-alphanumerics stripped
  label     String // display name captured when the game was pinned
  position  Int // 0-based rank; contiguous after every save
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
  @@map("featured_games")
}

model ProviderUserAccount {
  id               String       @id @default(uuid())
  providerId       String
  userId           String
  externalUserCode String // Palace's numeric user_code as string
  createdAt        DateTime     @default(now())
  provider         GameProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, userId])
  @@index([providerId])
  @@map("provider_user_accounts")
}

// Raw GASea transaction details + idempotency key.
// Every wallet callback creates one row here AND one row in the existing Transaction table.
model ThirdPartyTransaction {
  id                    String             @id @default(uuid())
  providerId            String
  userId                String
  transactionId         String // GASea's transactionId — idempotency key
  externalTransactionId String? // vendor-level transaction ID
  betId                 String?
  roundId               String?
  gameCode              String?
  type                  ThirdPartyTxType
  status                ThirdPartyTxStatus @default(COMPLETED)
  betAmount             Decimal?           @db.Decimal(20, 8)
  winAmount             Decimal?           @db.Decimal(20, 8)
  amount                Decimal            @db.Decimal(20, 8) // net (positive = credit, negative = debit)
  balanceBefore         Decimal            @db.Decimal(20, 8)
  balanceAfter          Decimal            @db.Decimal(20, 8)
  rawRequest            Json?
  rawResponse           Json?
  createdAt             DateTime           @default(now())

  @@unique([providerId, transactionId])
  @@index([userId])
  @@index([roundId])
  @@index([createdAt])
  @@map("third_party_transactions")
}

// ─── Behavioral Analytics Events ─────────────────────────────────────────────
model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  userId    String?
  anonId    String?
  sessionId String?
  props     Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([anonId])
  @@index([userId])
  @@map("analytics_events")
}

// ─── Deposit Auto-Verification ────────────────────────────────────────────────
// One row per deposit's automated verification attempt against the canonical
// telebirr receipt. Audit/state only — the credit itself still flows through
// WalletService.approveDeposit.
model DepositVerification {
  id                   String                    @id @default(uuid())
  transactionId        String                    @unique
  transaction          Transaction               @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  status               DepositVerificationStatus @default(PENDING)
  source               DepositVerificationSource @default(RECEIPT_FETCH)
  decision             String?
  decisionReasons      String[]
  receiverName         String?
  receiverNumberMasked String?
  settledAmount        Decimal?                  @db.Decimal(12, 2)
  totalPaid            Decimal?                  @db.Decimal(12, 2)
  receiptStatus        String?
  receiptNumber        String?
  receiptTime          DateTime?
  payerName            String?
  payerNumberMasked    String?
  rawSnapshot          Json?
  attempts             Int                       @default(0)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([status])
  @@map("deposit_verifications")
}

enum DepositVerificationStatus {
  PENDING
  AUTO_CREDITED
  MANUAL_REQUIRED
  UNAVAILABLE
}

enum DepositVerificationSource {
  RECEIPT_FETCH
}

/// One row per received ZareCash webhook delivery. Delivery is at-least-once,
/// so this table is both the dedupe key and the audit trail.
model ZareCashEvent {
  id          String    @id // evt_… assigned by ZareCash
  type        String
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@index([type])
  @@index([processedAt])
  @@map("zarecash_events")
}

// ─── Player CRM ───────────────────────────────────────────────────────────────

/// One row per user, rebuilt from source rows by PlayerMetricsService.
/// Every value is an ABSOLUTE RECOMPUTE, never an increment, so a retry or two
/// overlapping refresh runs converge on the same answer instead of drifting.
model PlayerMetrics {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Deposits / withdrawals — counted only at PaymentStatus.APPROVED, so receipts
  // sitting in PENDING_REVIEW never inflate a VIP segment.
  lifetimeDeposits    Decimal   @default(0) @db.Decimal(14, 2)
  depositCount        Int       @default(0)
  firstDepositAt      DateTime?
  lastDepositAt       DateTime?
  lifetimeWithdrawals Decimal   @default(0) @db.Decimal(14, 2)
  withdrawalCount     Int       @default(0)
  lastWithdrawalAt    DateTime?

  // Bingo play
  gamesPlayed    Int       @default(0)
  cartelasBought Int       @default(0)
  firstPlayedAt  DateTime?
  lastPlayedAt   DateTime?
  totalStaked    Decimal   @default(0) @db.Decimal(14, 2)
  totalWon       Decimal   @default(0) @db.Decimal(14, 2)
  netLoss        Decimal   @default(0) @db.Decimal(14, 2)

  // Third-party providers (Palace / GASea)
  tpStaked       Decimal   @default(0) @db.Decimal(14, 2)
  tpWon          Decimal   @default(0) @db.Decimal(14, 2)
  lastTpPlayedAt DateTime?

  bonusReceived   Decimal  @default(0) @db.Decimal(14, 2)
  referralCount   Int      @default(0)
  avgDailyDeposit Decimal? @db.Decimal(12, 2)

  // Precomputed recency. Stored as ints so "churned = daysSinceLastPlay > 30"
  // is an index scan rather than a per-row date subtraction.
  daysSinceLastDeposit Int?
  daysSinceLastPlay    Int?
  tenureDays           Int  @default(0)

  // Denormalized from User + Wallet so segment queries and CSV export never join.
  // serial and username are here for exactly that reason: they are what the
  // players screen displays, and without them every preview would join `users`,
  // which is the cost this table exists to avoid.
  realBalance  Decimal  @default(0) @db.Decimal(20, 8)
  bonusBalance Decimal  @default(0) @db.Decimal(20, 8)
  isActive     Boolean  @default(true)
  registeredAt DateTime
  serial       Int?
  username     String?
  phone        String?
  telegramId   String?

  refreshedAt DateTime @default(now())

  @@index([lastPlayedAt])
  @@index([lastDepositAt])
  @@index([lifetimeDeposits])
  @@index([netLoss])
  @@index([daysSinceLastPlay])
  @@index([daysSinceLastDeposit])
  @@map("player_metrics")
}

/// A saved audience definition. Presets are seeded rows, not code, so "preset"
/// and "custom" are the same thing and clone-and-tweak works on day one.
model Segment {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  rules       Json
  isPreset    Boolean     @default(false)
  cachedCount Int?
  countedAt   DateTime?
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  campaigns   Campaign[]
  bonusRules  BonusRule[]

  @@map("segments")
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model Campaign {
  id        String         @id @default(uuid())
  name      String
  segmentId String
  segment   Segment        @relation(fields: [segmentId], references: [id])
  actions   Json
  status    CampaignStatus @default(DRAFT)

  /// Identity that survives cloning. Delivery uniqueness keys on this, not on id,
  /// so cloning a stopped campaign and relaunching cannot re-pay people who were
  /// already paid by the original.
  rootId String

  /// The rules AS APPROVED, plus the instant they were evaluated against. The
  /// drain compiles from these, never from the live Segment row — otherwise
  /// editing the segment after approval silently retargets a running campaign,
  /// and maxRecipients caps only HOW MANY, never WHICH.
  segmentRulesSnapshot Json
  asOf                 DateTime

  // Caps are NOT NULL. A nullable maxRecipients becomes `LIMIT NULL` in Postgres,
  // which means NO LIMIT — the cap would silently delete itself.
  maxRecipients Int     @default(1000)
  maxTotalBonus Decimal @default(0) @db.Decimal(14, 2)
  maxPerPlayer  Decimal @default(0) @db.Decimal(12, 2)

  // Authorship + approval. Four-eyes is checked against BOTH createdById and
  // lastEditedById: comparing only the original author lets someone edit a
  // colleague's draft and then approve it themselves.
  createdById        String?
  lastEditedById     String?
  approvedById       String?
  /// Usernames captured at write time. Clerk deletion hard-deletes the user row,
  /// which would otherwise turn every actor id into an unresolvable UUID exactly
  /// when someone is auditing who authorised a payment.
  createdByUsername  String?
  approvedByUsername String?
  approvalNote       String?
  approvedAt         DateTime?
  /// sha256 over {segment rules, actions, caps} at approval time, re-verified
  /// under the campaign row lock before any money moves — so editing an
  /// approved campaign cannot smuggle a larger amount past its approver.
  approvalHash       String?

  snapshotSize Int?
  queuedCount  Int     @default(0)
  sentCount    Int     @default(0)
  skippedCount Int     @default(0)
  failedCount  Int     @default(0)
  grantedTotal Decimal @default(0) @db.Decimal(14, 2)

  startedAt      DateTime?
  finishedAt     DateTime?
  lastProgressAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  deliveries CampaignDelivery[]

  @@index([status])
  @@map("campaigns")
}

enum CampaignDeliveryStatus {
  QUEUED
  SENT
  SKIPPED
  FAILED
}

/// One row per player per campaign, materialised at launch so the recipient list
/// is frozen and every terminal state is an UPDATE of an existing row. That makes
/// "who was in this campaign and what happened to them" a single query, and a
/// stuck QUEUED row the alarm for a lost job.
model CampaignDelivery {
  id         String                 @id @default(uuid())
  campaignId String
  campaign   Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// Copied from Campaign.rootId. Uniqueness keys on this so a clone of a stopped
  /// campaign cannot re-deliver to someone the original already paid.
  rootId     String
  userId     String
  // Restrict, not Cascade: deleting a user must not erase the record of money
  // paid to them, or the reconciliation invariants silently pass.
  user       User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  status     CampaignDeliveryStatus @default(QUEUED)

  notificationId String?
  transactionId  String?
  bonusAmount    Decimal? @db.Decimal(12, 2)
  skipReason     String?
  error          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The idempotency guarantee: a retried worker cannot pay the same player twice,
  /// and neither can a clone of the same campaign lineage.
  @@unique([rootId, userId])
  @@index([campaignId, status])
  @@map("campaign_deliveries")
}

/// Append-only record of privileged actions.
///
/// This platform has no audit trail at all, which is why a rogue role change or a
/// PII export currently leaves no durable trace. The CSV export is what forces the
/// issue: a file of player phone numbers leaves the building and the only evidence
/// is a log line inside a retention window.
model AuditLog {
  id        String   @id @default(uuid())
  action    String
  actorId   String?
  /// Denormalized: the actor row can be hard-deleted.
  actorName String?
  /// What was acted on, e.g. "segment:<id>" or "campaign:<id>".
  target    String?
  detail    Json?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

// ─── Prediction Market (binary order book) ───────────────────────────────────

enum PredictionMarketStatus {
  DRAFT
  OPEN
  CLOSED
  RESOLVING
  SETTLED
  VOIDED
}

enum PredictionOrderStatus {
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
}

enum PredictionPositionStatus {
  OPEN
  WON
  LOST
  REFUNDED
}

/// A binary market on a third-party event. `shareValue` lives here rather than as a
/// global constant so a future card can run a different denomination without a
/// migration — every escrow and payout reads it from the market, never from a
/// hardcoded 100. `feePct` is likewise snapshotted at creation so changing the
/// setting can never move money already escrowed.
model PredictionMarket {
  id               String                 @id @default(uuid())
  eventName        String
  question         String
  description      String?
  imageUrl         String?
  status           PredictionMarketStatus @default(DRAFT)
  closesAt         DateTime
  resolvesAt       DateTime?
  shareValue       Decimal                @default(100) @db.Decimal(12, 2)
  feePct           Decimal                @default(15) @db.Decimal(5, 2)
  minOrderShares   Int                    @default(1)
  maxOrderShares   Int                    @default(10000)
  /// Matched share pairs.
  totalShares      Int                    @default(0)
  /// ETB escrowed.
  totalVolume      Decimal                @default(0) @db.Decimal(14, 2)
  winningOutcomeId String?
  resolvedById     String?
  resolvedAt       DateTime?
  disputeUntil     DateTime?
  settledAt        DateTime?
  voidReason       String?
  createdById      String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  outcomes         PredictionOutcome[]
  orders           PredictionOrder[]
  fills            PredictionFill[]
  positions        PredictionPosition[]

  @@index([status, closesAt])
  @@map("prediction_markets")
}

model PredictionOutcome {
  id        String               @id @default(uuid())
  marketId  String
  label     String
  sortOrder Int
  lastPrice Decimal?             @db.Decimal(12, 2)
  market    PredictionMarket     @relation(fields: [marketId], references: [id], onDelete: Cascade)
  orders    PredictionOrder[]
  positions PredictionPosition[]

  @@unique([marketId, sortOrder])
  @@map("prediction_outcomes")
}

/// Buy-only limit order. The reserve leaves the wallet at placement, split into
/// `reservedReal`/`reservedBonus`, so a resting order is always fully funded and
/// matching can never fail for lack of money.
model PredictionOrder {
  id             String                @id @default(uuid())
  marketId       String
  outcomeId      String
  userId         String
  /// 1.00 .. shareValue - 1, in whole 1 ETB ticks.
  limitPrice     Decimal               @db.Decimal(12, 2)
  quantity       Int
  filledQuantity Int                   @default(0)
  reservedReal   Decimal               @default(0) @db.Decimal(12, 2)
  reservedBonus  Decimal               @default(0) @db.Decimal(12, 2)
  status         PredictionOrderStatus @default(OPEN)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  market         PredictionMarket      @relation(fields: [marketId], references: [id], onDelete: Cascade)
  outcome        PredictionOutcome     @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // the matching hot path: resting orders on one side, best price first, oldest first
  @@index([marketId, outcomeId, status, limitPrice, createdAt])
  @@index([userId, status])
  @@map("prediction_orders")
}

model PredictionFill {
  id             String           @id @default(uuid())
  marketId       String
  quantity       Int
  takerOrderId   String
  makerOrderId   String
  takerOutcomeId String
  makerOutcomeId String
  takerPrice     Decimal          @db.Decimal(12, 2)
  /// takerPrice + makerPrice == shareValue
  makerPrice     Decimal          @db.Decimal(12, 2)
  createdAt      DateTime         @default(now())
  market         PredictionMarket @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId, createdAt])
  @@map("prediction_fills")
}

/// Cost basis is carried split so a void refunds bonus as bonus and real as real —
/// refunding a bonus-funded position to real balance would turn promotional credit
/// into withdrawable cash.
model PredictionPosition {
  id             String                   @id @default(uuid())
  marketId       String
  outcomeId      String
  userId         String
  shares         Int                      @default(0)
  costBasisReal  Decimal                  @default(0) @db.Decimal(12, 2)
  costBasisBonus Decimal                  @default(0) @db.Decimal(12, 2)
  status         PredictionPositionStatus @default(OPEN)
  payout         Decimal                  @default(0) @db.Decimal(12, 2)
  feePaid        Decimal                  @default(0) @db.Decimal(12, 2)
  settledAt      DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  market         PredictionMarket         @relation(fields: [marketId], references: [id], onDelete: Cascade)
  outcome        PredictionOutcome        @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([marketId, outcomeId, userId])
  @@index([userId, status])
  @@index([marketId, status])
  @@map("prediction_positions")
}

// ─── Support Chat ────────────────────────────────────────────────────────────

enum SupportConversationStatus {
  BOT
  OPEN
  ASSIGNED
  RESOLVED
}

enum SupportSenderRole {
  PLAYER
  AI
  AGENT
  SYSTEM
}

/// One-live-conversation-per-player is enforced by a PARTIAL UNIQUE INDEX,
/// support_conversations_one_live_per_user ON ("userId") WHERE status <>
/// 'RESOLVED', hand-written as raw SQL at the end of migration
/// 20260822000000_add_support_chat/migration.sql. Prisma cannot express a
/// partial index in schema.prisma, so nothing below declares it — which
/// means `prisma migrate dev` has NO IDEA it exists and will happily emit a
/// DROP INDEX for it the next time this model's migration diff is
/// generated, silently disabling the invariant this whole feature relies
/// on (a double-tapped widget button creating two live threads, one of
/// which is invisible to its own author). This is documentation only — do
/// not attempt to express the partial index in Prisma. Any migration that
/// touches support_conversations must re-add it by hand afterward.
model SupportConversation {
  id           String                    @id @default(uuid())
  userId       String
  user         User                      @relation("SupportConversations", fields: [userId], references: [id], onDelete: Cascade)
  status       SupportConversationStatus @default(OPEN)
  assignedToId String?
  assignedTo   User?                     @relation("SupportAssignments", fields: [assignedToId], references: [id], onDelete: SetNull)

  /// Detected thread language: "en" | "am" | "am-Latn". Phase 1 always writes "en";
  /// Phase 2's detector owns this column.
  language String @default("en")

  /// Consecutive AI replies since the last human turn. Phase 2 reads it; Phase 1
  /// leaves it at 0 so the column exists before the AI service needs it.
  aiTurnCount         Int @default(0)
  lowConfidenceStreak Int @default(0)

  lastMessageAt DateTime  @default(now())
  escalatedAt   DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages SupportMessage[]

  @@index([status, lastMessageAt])
  @@index([userId, lastMessageAt])
  @@index([assignedToId, status])
  @@map("support_conversations")
}

model SupportMessage {
  id             String              @id @default(uuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderRole     SupportSenderRole
  /// User id for PLAYER and AGENT. Null for AI and SYSTEM.
  senderId       String?
  body           String              @db.Text
  attachmentUrl  String?
  attachmentMime String?
  readByPlayerAt DateTime?
  readByAgentAt  DateTime?
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
  @@map("support_messages")
}
